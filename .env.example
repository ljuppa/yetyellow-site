# Create a Resend API key with permission to send email from your verified domain.
RESEND_API_KEY=re_replace_with_your_key

# Use an address on the verified yetyellow.nl domain for the sender.
CONTACT_FROM_EMAIL=Yetyellow website <contact@yetyellow.nl>

# Messages from the form are delivered to this Hostinger mailbox.
CONTACT_TO_EMAIL=connect@yetyellow.nl
