---
import '../styles/global.css';

interface Props {
  description?: string;
  title?: string;
}

const {
  description = 'Engineering leadership and applied AI for complex engineering organisations.',
  title = 'Yetyellow | Engineering leadership and applied AI',
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL('/og-image.png', Astro.site ?? Astro.url);
const navigation = [
  { href: '/', label: 'Home' },
  { href: '/now', label: 'Now' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yetyellow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="2172" />
    <meta property="og:image:height" content="724" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/"><img src="/yetyellow-logo.png" alt="Yetyellow" /></a>
      <nav aria-label="Primary navigation">
        <ul class="nav-list">
          {navigation.map((item) => (
            <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a class="nav-contact" href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <span>YETYELLOW / ENGINEERING LEADERSHIP AND APPLIED AI</span>
      <span>CURRENTLY: AI ADOPTION IN ENGINEERING</span>
    </footer>
  </body>
</html>
