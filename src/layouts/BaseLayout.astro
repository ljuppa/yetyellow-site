---
import '../styles/global.css';

interface Props {
  description?: string;
  title?: string;
}

const {
  description = 'Engineering leadership and applied AI for complex engineering organisations.',
  title = 'Yetyellow | Engineering leadership and applied AI',
} = Astro.props;

const currentPath = Astro.url.pathname;
const navigation = [
  { href: '/', label: 'Home' },
  { href: '/now', label: 'Now' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0a" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/"><img src="/yetyellow-logo.png" alt="Yetyellow" /></a>
      <nav aria-label="Primary navigation">
        <ul class="nav-list">
          {navigation.map((item) => (
            <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a class="nav-contact" href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <span>YETYELLOW / ENGINEERING LEADERSHIP AND APPLIED AI</span>
      <span>CURRENTLY: AI ADOPTION IN ENGINEERING</span>
    </footer>
  </body>
</html>
