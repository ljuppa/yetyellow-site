---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Yetyellow" description="Contact Ljupcho Stojcheski.">
  <section class="page-hero compact contact-page">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch.</h1>
    <p class="lede">If you are working on AI adoption, scaling your team, or building highly performing teams, send me a message.</p>
    <form class="contact-form" action="/api/contact" method="post" data-contact-form>
      <label>
        Name
        <input name="name" autocomplete="name" required maxlength="100" />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required maxlength="254" />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required maxlength="4000"></textarea>
      </label>
      <label class="visually-hidden" aria-hidden="true">
        Leave this field empty
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
      <button class="button button-primary" type="submit">Send a message</button>
      <p class="form-status" data-form-status aria-live="polite"></p>
    </form>
    <div class="contact-links">
      <a class="text-link" href="mailto:connect@yetyellow.nl">Prefer email?</a>
      <a class="text-link" href="https://www.linkedin.com/in/ljuppa/" rel="me">LinkedIn</a>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (!submitButton || !status) return;

    submitButton.disabled = true;
    status.textContent = 'Sending...';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json() as { message?: string };

      if (!response.ok) throw new Error(result.message);

      form.reset();
      status.textContent = result.message ?? 'Thank you. Your message has been sent.';
    } catch (error) {
      status.textContent = error instanceof Error && error.message
        ? error.message
        : 'The form is temporarily unavailable. Please email me directly.';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
