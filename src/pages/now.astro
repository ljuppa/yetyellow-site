---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Now | Yetyellow" description="What Yetyellow is currently learning and building.">
  <section class="page-hero compact">
    <p class="eyebrow">Now</p>
    <h1>Current direction.</h1>
    <p class="lede">A compact status page for the work in motion. Updated when there is a change worth recording.</p>
  </section>
  <section class="now-list" aria-label="Current focus areas">
    <article><span class="mono">01 / PRACTICE</span><h2>Agent design and evaluation</h2><p>Learning how to define useful tasks, establish boundaries, evaluate output and retain accountable human control.</p></article>
    <article><span class="mono">02 / BUILD</span><h2>Workflow automation</h2><p>Exploring small, concrete automations that reduce administrative drag in engineering work.</p></article>
    <article><span class="mono">03 / CONTEXT</span><h2>AI-enabled engineering leadership</h2><p>Connecting technical capability to adoption, delivery practice and organisational judgement.</p></article>
  </section>
</BaseLayout>
